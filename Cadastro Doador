<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cadastro doador – Doa Fácil</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="pagina">

  <aside class="painel-marca">
    <a class="logo" href="index.html" aria-label="Doa Fácil – página inicial">Doa <span>Fácil</span></a>
    <div class="chamada">
      <span class="detalhe" aria-hidden="true"></span>
      <p>Doe itens e<br>ajude a sua<br>comunidade.</p>
    </div>
  </aside>

  <main class="area-formulario alinhado-topo">
    <div class="coluna coluna-larga">

      <a class="voltar" href="index.html" aria-label="Voltar para o login">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor"
             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 10H4"/>
          <path d="M9 5l-5 5 5 5"/>
        </svg>
      </a>

      <header class="cabecalho-cadastro">
        <h1>Cadastro doador</h1>
        <p>Crie sua conta para doar itens para instituições e pessoas da sua região.</p>
      </header>

      <form class="cadastro-form" action="#" method="post">

        <div class="campo">
          <label for="nome">Nome completo:</label>
          <input id="nome" name="nome" type="text" autocomplete="name"
                 placeholder="Digite seu nome completo">
        </div>

        <div class="linha">
          <div class="campo">
            <label for="email">E-mail</label>
            <input id="email" name="email" type="email" autocomplete="email"
                   placeholder="exemplo@email.com">
          </div>
          <div class="campo">
            <label for="telefone">Telefone</label>
            <input id="telefone" name="telefone" type="tel" autocomplete="tel"
                   placeholder="(00) 00000-0000">
          </div>
        </div>

        <div class="campo">
          <label for="endereco">Endereço</label>
          <input id="endereco" name="endereco" type="text" autocomplete="street-address"
                 placeholder="Digite seu endereço">
        </div>

        <div class="linha">
          <div class="campo">
            <label for="senha">Senha</label>
            <div class="campo-senha">
              <input id="senha" name="senha" type="password" autocomplete="new-password"
                     placeholder="Crie uma senha">
              <button class="ocultar" type="button" aria-label="Mostrar senha" aria-pressed="false">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 10s3-5.5 8-5.5S18 10 18 10s-3 5.5-8 5.5S2 10 2 10Z"/>
                  <circle cx="10" cy="10" r="2.5"/>
                  <path class="risco" d="M3.5 16.5 16.5 3.5"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="campo">
            <label for="confirmar-senha">Confirmar senha</label>
            <div class="campo-senha">
              <input id="confirmar-senha" name="confirmar-senha" type="password" autocomplete="new-password"
                     placeholder="Confirme sua senha">
              <button class="ocultar" type="button" aria-label="Mostrar senha" aria-pressed="false">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 10s3-5.5 8-5.5S18 10 18 10s-3 5.5-8 5.5S2 10 2 10Z"/>
                  <circle cx="10" cy="10" r="2.5"/>
                  <path class="risco" d="M3.5 16.5 16.5 3.5"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <button class="btn btn-cheio" type="submit">Criar conta</button>
      </form>

    </div>
  </main>

</div>

<script>
  // Mostrar/ocultar senha em cada campo de senha
  document.querySelectorAll('.ocultar').forEach((botao) => {
    const campo = botao.parentElement.querySelector('input');
    botao.addEventListener('click', () => {
      const visivel = campo.type === 'text';
      campo.type = visivel ? 'password' : 'text';
      botao.setAttribute('aria-pressed', String(!visivel));
      botao.setAttribute('aria-label', visivel ? 'Mostrar senha' : 'Ocultar senha');
    });
  });
</script>
</body>
</html>
